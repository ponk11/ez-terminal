{
  "name": "ez-terminal",
  "version": "1.0.0",
  "private": true,
  "description": "A clean, local web terminal for macOS, Linux, and Windows.",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build",
    "check": "npm run build",
    "start": "node server/index.js",
    "start:docker": "node --eval \"process.env.EZ_TERMINAL_MODE='docker'; import('./server/index.js')\""
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^5.1.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "vite": "^7.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  }
}
